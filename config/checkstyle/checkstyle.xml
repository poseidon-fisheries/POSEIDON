<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
  "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
  "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
  <property name="severity" value="error"/>

  <!-- Tests document themselves through their names -->
  <module name="SuppressionSingleFilter">
    <property name="checks" value="MissingJavadoc(Type|Method)"/>
    <property name="files" value="[\\/]src[\\/]test[\\/]"/>
  </module>

  <module name="TreeWalker">
    <!-- Getters and setters, overrides, and comments made only of tags pass -->
    <module name="MissingJavadocType"/>
    <module name="MissingJavadocMethod">
      <property name="allowMissingPropertyJavadoc" value="true"/>
      <property name="tokens"
                value="METHOD_DEF, CTOR_DEF, ANNOTATION_FIELD_DEF, COMPACT_CTOR_DEF"/>
    </module>

    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="FinalParameters">
      <property name="tokens"
                value="METHOD_DEF, CTOR_DEF, LITERAL_CATCH, FOR_EACH_CLAUSE"/>
    </module>
    <module name="FinalLocalVariable">
      <property name="tokens" value="VARIABLE_DEF"/>
    </module>
    <module name="UnusedLocalVariable"/>

    <!-- An empty catch block is allowed when its variable says it is ignored -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="ignored"/>
    </module>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
  </module>
</module>
