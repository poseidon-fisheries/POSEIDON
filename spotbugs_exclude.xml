<FindBugsFilter>
    <Match>
        <!--
        The `eu.project.surimi` package contains gRPC generated classes that are structured
        in ways that SpotBugs finds unholy. The protocol as at the prototype stage
        now and the name of the package will change, but we will still have to
        exclude it like this down the line.
        -->
        <Package name="eu.project.surimi"/>
    </Match>
    <Match>
        <!-- @SuppressFBWarnings doesn't work on records so we do this here -->
        <Class name="uk.ac.ox.poseidon.fishing.market.BiomassMarket$Price"/>
    </Match>
    <Match>
        <!-- Constructor validation throws are a common and safe pattern -->
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <!-- Tests pass null on purpose to check that it is rejected -->
        <Class name="~.*Test"/>
        <Bug pattern="NP_NONNULL_PARAM_VIOLATION"/>
    </Match>
</FindBugsFilter>
